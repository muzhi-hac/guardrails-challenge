# Copy to `.env` and fill in. `.env` is gitignored and must not be committed.
#
# Nothing in this project auto-loads `.env` — the provider reads the process
# environment directly. Load it in your shell before running the CLI:
#
#     set -a; source .env; set +a
#
# The default test suite needs neither variable and runs fully offline.
# The CLI and the live-marked tests (`pytest -m live`) need the key.

# Your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional. Set only if you route requests through a relay or gateway;
# leave empty to talk to the Anthropic API directly.
ANTHROPIC_BASE_URL=
